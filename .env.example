NODE_ENV=production
DEPLOYMENT_STAGE=production
PORT=4173

DATA_DIR=/var/data
UPLOAD_DIR=/var/data/uploads
PERSISTENT_DISK_MOUNT_PATH=/var/data

ADMIN_EMAIL=coffeebreaktcg@gmail.com
ADMIN_PASSWORD_HASH=
MAX_JSON_BODY_BYTES=8388608

RESEND_API_KEY=
RESEND_FROM_EMAIL=Coffee Break TCG <orders@coffeebreaktcg.com>

SQUARE_ENVIRONMENT=production
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://coffeebreaktcg.com/api/square/webhook

GOOGLE_DRIVE_BACKUP_FOLDER_ID=
GOOGLE_DRIVE_BACKUP_FILE_ID=
GOOGLE_DRIVE_BACKUP_FILE_NAME=coffee-break-latest-backup.zip
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=

MARKET_PRICE_PROVIDER=local
MARKET_USD_TO_CAD=
POKEMON_TCG_API_KEY=
TCG_API_KEY=
CANADA_POST_ADDRESS_KEY=

USD_TO_CAD_RATE=1.38

# Security: canonical HTTPS origin in production (no trailing path).
PUBLIC_ORIGIN=https://coffeebreaktcg.com
# Optional extra same-site origins, comma separated, e.g. a www alias.
ALLOWED_ORIGINS=
# 0 for direct local access. On Render, set to the verified number of trusted
# reverse-proxy hops. Read X-Forwarded-For from the right, not the left.
TRUST_PROXY_HOPS=0
